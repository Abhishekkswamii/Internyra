{
  "name": "internyra-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-internyra \"playwright test\"",
    "admin:claim": "tsx scripts/set-admin-claim.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-internyra \"vitest run --config vitest.rules.config.mts\"",
    "smoke:redis": "node --env-file=.env.local node_modules/.bin/tsx scripts/smoke-redis.ts",
    "smoke:ai": "node --env-file=.env.local node_modules/.bin/tsx scripts/smoke-ai.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@types/three": "^0.186.0",
    "@upstash/redis": "^1.41.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "openai": "^7.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
