# Copy to .env.local and fill in. NEVER commit real values. Server secrets must never use NEXT_PUBLIC_.
# On Firebase App Hosting, secrets live in Secret Manager (see docs/DEPLOYMENT.md), not in files.

# --- Firebase web config (public identifiers; safe in the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only). On App Hosting these are not needed: Application Default Credentials are used. ---
FIREBASE_PROJECT_ID=
# Local development only, and only if you are not using `gcloud auth application-default login`:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AI providers (server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Order in which providers are tried. Gemini first; one OpenAI fallback for provider-side failures.
AI_PROVIDER_ORDER=gemini,openai
# Use the provider's web search tool only after `npm run smoke:ai` shows it is available for your model.
AI_WEB_SEARCH_ENABLED=false
# Kill switch. Keep false until a provider key is installed and smoke-tested.
AI_INSPECTIONS_ENABLED=false

# --- Upstash Redis (server only; cache and locks only, Firestore remains the source of truth) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
# UID of the single administrator account (an ordinary Firebase Auth user; see docs/DEPLOYMENT.md).
ADMIN_UID=
APP_BASE_URL=http://localhost:3000
